        "\n",
        "!pip -q install pandas matplotlib seaborn\n",
        "!apt-get -qq install -y r-base\n",
        "!Rscript -e 'install.packages(\"ggplot2\", repos=\"https://cloud.r-project.org\", quiet=TRUE)'\n",
        "\n",
        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "import seaborn as sns\n",
        "import zipfile, glob, subprocess\n",
        "from google.colab import files\n",
        "from IPython.display import Image, display, Markdown\n",
        "\n",
        "# Upload dataset\n",
        "uploaded = files.upload()\n",
        "with zipfile.ZipFile(next(iter(uploaded))) as z:\n",
        "    z.extractall(\"data\")\n",
        "\n",
        "df = pd.read_csv(glob.glob(\n",
        "    \"data/**/firearm_homicides_country_year.csv\",\n",
        "    recursive=True\n",
        ")[0])\n",
        "\n",
        "sns.set_theme(style=\"whitegrid\")\n",
        "\n",
        "# ==============================\n",
        "# 1. MATPLOTLIB\n",
        "# ==============================\n",
        "\n",
        "display(Markdown(\"# 1. MATPLOTLIB\"))\n",
        "\n",
        "trend = df.groupby(\"year\").homicide_rate.mean()\n",
        "\n",
        "plt.figure(figsize=(9, 5))\n",
        "plt.plot(trend.index, trend.values, marker=\"o\")\n",
        "plt.title(\"Homicide Rate Over Time\")\n",
        "plt.xlabel(\"Year\")\n",
        "plt.ylabel(\"Average Homicide Rate\")\n",
        "plt.tight_layout()\n",
        "plt.show()\n",
        "\n",
        "# ==============================\n",
        "# 2. SEABORN\n",
        "# ==============================\n",
        "\n",
        "display(Markdown(\"# 2. SEABORN\"))\n",
        "\n",
        "plt.figure(figsize=(9, 5))\n",
        "sns.barplot(data=df, x=\"region\", y=\"homicide_rate\")\n",
        "plt.title(\"Homicide Rate by Region\")\n",
        "plt.xlabel(\"Region\")\n",
        "plt.ylabel(\"Homicide Rate\")\n",
        "plt.xticks(rotation=30)\n",
        "plt.tight_layout()\n",
        "plt.show()\n",
        "\n",
        "# ==============================\n",
        "# 3. GGPLOT2\n",
        "# ==============================\n",
        "\n",
        "display(Markdown(\"# 3. GGPLOT2\"))\n",
        "\n",
        "df.to_csv(\"data.csv\", index=False)\n",
        "\n",
        "r_code = '''\n",
        "library(ggplot2)\n",
        "df <- read.csv(\"data.csv\")\n",
        "\n",
        "p <- ggplot(df, aes(year, homicide_rate)) +\n",
        "  stat_summary(fun=mean, geom=\"line\", color=\"blue\") +\n",
        "  stat_summary(fun=mean, geom=\"point\") +\n",
        "  labs(title=\"Homicide Rate Over Time\",\n",
        "       x=\"Year\", y=\"Average Homicide Rate\") +\n",
        "  theme_minimal()\n",
        "\n",
        "ggsave(\"plot.png\", p, width=9, height=5)\n",
        "'''\n",
        "\n",
        "with open(\"plot.R\", \"w\") as f:\n",
        "    f.write(r_code)\n",
        "\n",
        "subprocess.run([\"Rscript\", \"plot.R\"], check=True)\n",
        "display(Image(\"plot.png\"))\n",
        "\n",
        "# ==============================\n",
        "# END\n",
